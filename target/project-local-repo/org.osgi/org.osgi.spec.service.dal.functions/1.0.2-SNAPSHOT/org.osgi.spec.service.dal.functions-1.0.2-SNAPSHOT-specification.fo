                                     xmlns:xlink="http://www.w3.org/1999/xlink"
                                     font-family="ProductusSemibold,ArialUnicodeMS"
                                     font-weight="normal"
                                     keep-with-next.within-column="always"
                                     space-before.minimum="0.8em"
                                     space-before.optimum="1.0em"
                                     space-before.maximum="1.2em"
                                     text-align="start"
                                     start-indent="0pt"
                                     hyphenate="false">
                              <fo:block font-size="12pt"
                                        line-height="14pt"
                                        space-before="8pt"
                                        space-after="5pt">
                                 <fo:list-block provisional-distance-between-starts="1in"
                                                provisional-label-separation="0.090in">
                                    <fo:list-item>
                                       <fo:list-item-label end-indent="label-end()" text-align="start">
                                          <fo:block>142.4.4</fo:block>
                                       </fo:list-item-label>
                                       <fo:list-item-body start-indent="body-start()">
                                          <fo:block>public abstract BooleanSensor<fo:block line-height="0pt"/> extends Function</fo:block>
                                       </fo:list-item-body>
                                    </fo:list-item>
                                 </fo:list-block>
                              </fo:block>
                           </fo:block>
                        </fo:block>
                     </fo:block>
                  </fo:block>
               </fo:block>
               <fo:block space-before.optimum="5pt"
                         space-before.minimum="5pt"
                         space-before.maximum="5pt">
{@code BooleanSensor} function provides boolean sensor monitoring. It reports
 its state when an important event is available. The eventable state is
 accessible with {@link #getData()} getter. There are no operations.
 </fo:block>
               <fo:block space-before.optimum="5pt"
                         space-before.minimum="5pt"
                         space-before.maximum="5pt">
 The sensor type can be:
 </fo:block>
               <fo:list-block space-before.optimum="1em"
                              space-before.minimum="0.8em"
                              space-before.maximum="1.2em"
                              space-after.optimum="1em"
                              space-after.minimum="0.8em"
                              space-after.maximum="1.2em"
                              provisional-label-separation="0.2em"
                              provisional-distance-between-starts="12pt"
                              id="d615e1313">
                  <fo:list-item space-before.optimum="2pt"
                                space-before.minimum="2pt"
                                space-before.maximum="2pt"
                                id="d615e1314">
                     <fo:list-item-label end-indent="label-end()">
                        <fo:block>•</fo:block>
                     </fo:list-item-label>
                     <fo:list-item-body start-indent="body-start()">
                        <fo:block>
                           <fo:block>{@link Types#LIGHT}</fo:block>
                        </fo:block>
                     </fo:list-item-body>
                  </fo:list-item>
                  <fo:list-item space-before.optimum="2pt"
                                space-before.minimum="2pt"
                                space-before.maximum="2pt"
                                id="d615e1316">
                     <fo:list-item-label end-indent="label-end()">
                        <fo:block>•</fo:block>
                     </fo:list-item-label>
                     <fo:list-item-body start-indent="body-start()">
                        <fo:block>
                           <fo:block>{@link Types#GAS}</fo:block>
                        </fo:block>
                     </fo:list-item-body>
                  </fo:list-item>
                  <fo:list-item space-before.optimum="2pt"
                                space-before.minimum="2pt"
                                space-before.maximum="2pt"
                                id="d615e1318">
                     <fo:list-item-label end-indent="label-end()">
                        <fo:block>•</fo:block>
                     </fo:list-item-label>
                     <fo:list-item-body start-indent="body-start()">
