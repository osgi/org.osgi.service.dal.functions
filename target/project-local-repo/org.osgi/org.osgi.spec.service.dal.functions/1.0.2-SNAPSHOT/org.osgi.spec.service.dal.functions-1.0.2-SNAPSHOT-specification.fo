                                            baseline-shift="-1pt"
                                            font-size="9pt">□</fo:inline>
                              </fo:block>
                           </fo:list-item-label>
                           <fo:list-item-body start-indent="body-start()">
                              <fo:block>
Returns the current metering info. It's a getter method for
 {@link #PROPERTY_CURRENT} property.
   </fo:block>
