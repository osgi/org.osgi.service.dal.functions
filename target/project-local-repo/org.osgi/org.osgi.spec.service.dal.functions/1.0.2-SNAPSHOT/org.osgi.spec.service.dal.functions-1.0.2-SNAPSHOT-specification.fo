                           <fo:block>•</fo:block>
                        </fo:list-item-label>
                        <fo:list-item-body start-indent="body-start()">
                           <fo:block>
                              <fo:block>
                                 <fo:basic-link xmlns:d="http://docbook.org/ns/docbook"
                                                xmlns:xlink="http://www.w3.org/1999/xlink"
                                                internal-destination="org.osgi.service.dal.functions.Types.MOTION">
                                    <fo:inline color="blue"
                                               font-family="ProductusOSGiBookc,ArialUnicodeMS"
                                               letter-spacing="0.08em"
                                               hyphenate="false">MOTION</fo:inline>
                                 </fo:basic-link> - indicates that the
            <fo:inline font-family="ProductusOSGiBookc,ArialUnicodeMS"
                                            font-size="9pt"
                                            letter-spacing="0.08em">BooleanSensor</fo:inline> can detect motion. <fo:inline font-family="ProductusOSGiBookc,ArialUnicodeMS"
                                            font-size="9pt"
                                            letter-spacing="0.08em">true</fo:inline>
            state means that there is motion detection. <fo:inline font-family="ProductusOSGiBookc,ArialUnicodeMS"
                                            font-size="9pt"
                                            letter-spacing="0.08em">false</fo:inline>
            state means that there is no motion detection.</fo:block>
                           </fo:block>
                        </fo:list-item-body>
                     </fo:list-item>
                     <fo:list-item space-before.optimum="2pt"
                                   space-before.minimum="2pt"
                                   space-before.maximum="2pt"
                                   id="d615e361">
                        <fo:list-item-label end-indent="label-end()">
                           <fo:block>•</fo:block>
                        </fo:list-item-label>
                        <fo:list-item-body start-indent="body-start()">
