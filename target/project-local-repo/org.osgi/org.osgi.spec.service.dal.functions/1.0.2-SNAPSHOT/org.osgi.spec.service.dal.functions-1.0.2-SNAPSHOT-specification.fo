      <fo:flow flow-name="xsl-region-body" start-indent="1in" end-indent="0pt">
         <fo:block id="service.dal.functions">
            <fo:block font-family="ProductusSemibold,ArialUnicodeMS">
               <fo:block margin-left="0pt">
                  <fo:block font-size="24.8832pt" font-weight="bold">
                     <fo:block xmlns:d="http://docbook.org/ns/docbook"
                               xmlns:xlink="http://www.w3.org/1999/xlink"
                               keep-with-next.within-column="always"
                               space-before.optimum="0in"
                               space-before.minimum="0in"
                               space-before.maximum="0in"
                               hyphenate="false"
                               text-align="start"
                               start-indent="0pt"
                               font-family="ProductusSemibold,ArialUnicodeMS"
                               font-size="28pt"
                               line-height="35pt"
                               font-weight="normal"
                               space-after="24pt">
                        <fo:list-block provisional-distance-between-starts="1in"
                                       provisional-label-separation="0.090in">
                           <fo:list-item>
                              <fo:list-item-label end-indent="label-end()" text-align="start">
                                 <fo:block>142</fo:block>
                              </fo:list-item-label>
                              <fo:list-item-body start-indent="body-start()">
                                 <fo:block>Device Abstraction Layer Functions Specification</fo:block>
                              </fo:list-item-body>
                           </fo:list-item>
                        </fo:list-block>
                     </fo:block>
                  </fo:block>
                  <fo:block>
                     <fo:block xmlns:d="http://docbook.org/ns/docbook"
                               xmlns:xlink="http://www.w3.org/1999/xlink"
                               font-family="ProductusOSGiBookcItalic"
                               font-size="18pt"
                               line-height="25pt">
                        <fo:basic-link internal-destination="org.osgi.service.dal.functions">
                           <fo:inline color="inherit"
                                      font-family="inherit"
                                      letter-spacing="inherit"
                                      hyphenate="inherit">Version 1.0</fo:inline>
                        </fo:basic-link>
                     </fo:block>
                  </fo:block>
               </fo:block>
            </fo:block>
         </fo:block>
         <fo:block id="service.dal.functions-introduction">
            <fo:block>
               <fo:block>
                  <fo:block keep-together.within-column="always"
                            margin-left="0pt"
                            font-family="ProductusSemibold,ArialUnicodeMS">
                     <fo:block keep-with-next.within-column="always">
                        <fo:block xmlns:d="http://docbook.org/ns/docbook"
                                  xmlns:xlink="http://www.w3.org/1999/xlink"
                                  font-family="ProductusSemibold,ArialUnicodeMS"
                                  font-weight="normal"
                                  keep-with-next.within-column="always"
                                  space-before.minimum="0.8em"
                                  space-before.optimum="1.0em"
                                  space-before.maximum="1.2em"
                                  text-align="start"
                                  start-indent="0pt"
                                  hyphenate="false">
                           <fo:marker marker-class-name="section.head.marker">Introduction</fo:marker>
                           <fo:block font-size="18pt"
                                     line-height="25pt"
                                     space-before="12.5pt"
                                     space-after="12pt">
                              <fo:list-block provisional-distance-between-starts="1in"
                                             provisional-label-separation="0.090in">
                                 <fo:list-item>
                                    <fo:list-item-label end-indent="label-end()" text-align="start">
                                       <fo:block>142.1</fo:block>
                                    </fo:list-item-label>
                                    <fo:list-item-body start-indent="body-start()">
                                       <fo:block>Introduction</fo:block>
                                    </fo:list-item-body>
                                 </fo:list-item>
                              </fo:list-block>
                           </fo:block>
                        </fo:block>
                     </fo:block>
                  </fo:block>
               </fo:block>
            </fo:block>
            <fo:block space-before.optimum="5pt"
                      space-before.minimum="5pt"
                      space-before.maximum="5pt">Concrete function interfaces are used to unify the access and the
    control of the basic device operations and the related properties. The
    current section specifies the minimal set of such functionalities. They
    can be extended or replaced to cover domain specific scenarios. The set is
    not closed and can be incorporated with vendor specific functions. There
    is support for: control, monitoring and metering information.</fo:block>
         </fo:block>
         <fo:block id="service.dal.functions-list">
            <fo:block>
               <fo:block>
                  <fo:block keep-together.within-column="always"
                            margin-left="0pt"
                            font-family="ProductusSemibold,ArialUnicodeMS">
                     <fo:block keep-with-next.within-column="always">
                        <fo:block xmlns:d="http://docbook.org/ns/docbook"
                                  xmlns:xlink="http://www.w3.org/1999/xlink"
                                  font-family="ProductusSemibold,ArialUnicodeMS"
                                  font-weight="normal"
                                  keep-with-next.within-column="always"
                                  space-before.minimum="0.8em"
                                  space-before.optimum="1.0em"
                                  space-before.maximum="1.2em"
                                  text-align="start"
                                  start-indent="0pt"
                                  hyphenate="false">
                           <fo:marker marker-class-name="section.head.marker">Functions</fo:marker>
                           <fo:block font-size="18pt"
                                     line-height="25pt"
                                     space-before="12.5pt"
                                     space-after="12pt">
                              <fo:list-block provisional-distance-between-starts="1in"
                                             provisional-label-separation="0.090in">
                                 <fo:list-item>
                                    <fo:list-item-label end-indent="label-end()" text-align="start">
                                       <fo:block>142.2</fo:block>
                                    </fo:list-item-label>
                                    <fo:list-item-body start-indent="body-start()">
                                       <fo:block>Functions</fo:block>
                                    </fo:list-item-body>
                                 </fo:list-item>
                              </fo:list-block>
                           </fo:block>
                        </fo:block>
                     </fo:block>
                  </fo:block>
               </fo:block>
            </fo:block>
            <fo:block id="service.dal.functions-boolean.control">
               <fo:block>
                  <fo:block>
                     <fo:block keep-together.within-column="always"
                               margin-left="0pt"
                               font-family="ProductusSemibold,ArialUnicodeMS">
                        <fo:block keep-with-next.within-column="always">
                           <fo:block xmlns:d="http://docbook.org/ns/docbook"
                                     xmlns:xlink="http://www.w3.org/1999/xlink"
                                     font-family="ProductusSemibold,ArialUnicodeMS"
                                     font-weight="normal"
                                     keep-with-next.within-column="always"
                                     space-before.minimum="0.8em"
                                     space-before.optimum="1.0em"
                                     space-before.maximum="1.2em"
                                     text-align="start"
                                     start-indent="0pt"
                                     hyphenate="false">
                              <fo:block font-size="12pt"
                                        line-height="14pt"
                                        space-before="8pt"
                                        space-after="5pt">
                                 <fo:list-block provisional-distance-between-starts="1in"
                                                provisional-label-separation="0.090in">
                                    <fo:list-item>
                                       <fo:list-item-label end-indent="label-end()" text-align="start">
                                          <fo:block>142.2.1</fo:block>
                                       </fo:list-item-label>
                                       <fo:list-item-body start-indent="body-start()">
                                          <fo:block>BooleanControl</fo:block>
                                       </fo:list-item-body>
                                    </fo:list-item>
                                 </fo:list-block>
                              </fo:block>
                           </fo:block>
                        </fo:block>
                     </fo:block>
                  </fo:block>
               </fo:block>
               <fo:block space-before.optimum="5pt"
                         space-before.minimum="5pt"
                         space-before.maximum="5pt">
                  <fo:basic-link xmlns:d="http://docbook.org/ns/docbook"
                                 xmlns:xlink="http://www.w3.org/1999/xlink"
                                 internal-destination="org.osgi.service.dal.functions.BooleanControl">
                     <fo:inline color="blue"
                                font-family="ProductusOSGiBookc,ArialUnicodeMS"
                                letter-spacing="0.08em"
                                hyphenate="false">BooleanControl</fo:inline>
                  </fo:basic-link> function provides a binary control support. The
      property eventing must follow the definition of Device Abstraction
      Layer, <fo:inline color="inherit"
                             font-family="inherit"
                             letter-spacing="inherit"
                             hyphenate="inherit">???</fo:inline>. The full function
      definition is available in the next tables.</fo:block>
               <fo:block xmlns:rx="http://www.renderx.com/XSL/Extensions"
                         space-before.minimum="0.5em"
                         space-before.optimum="1em"
                         space-before.maximum="2em"
                         space-after.minimum="0.5em"
                         space-after.optimum="1em"
                         space-after.maximum="2em"
                         keep-together.within-column="auto"
                         id="d615e99">
                  <fo:block xmlns:d="http://docbook.org/ns/docbook"
                            xmlns:xlink="http://www.w3.org/1999/xlink"
                            space-before.optimum="5pt"
                            space-before.minimum="5pt"
                            space-before.maximum="5pt"
                            font-weight="normal"
                            font-size="9pt"
                            hyphenate="false"
                            space-after.minimum="0.4em"
                            space-after.optimum="0.6em"
                            space-after.maximum="0.8em"
                            start-indent="0pt"
                            font-family="Proforma-Book,ArialUnicodeMS"
                            font-style="italic"
                            keep-with-next.within-column="always">
                     <fo:list-block provisional-distance-between-starts="1in"
                                    provisional-label-separation="0.090in">
                        <fo:list-item>
                           <fo:list-item-label end-indent="label-end()" text-align="start">
                              <fo:block>Table 142.1</fo:block>
                           </fo:list-item-label>
                           <fo:list-item-body start-indent="body-start()">
                              <fo:block>BooleanControl Operations</fo:block>
                           </fo:list-item-body>
                        </fo:list-item>
                     </fo:list-block>
                  </fo:block>
                  <fo:table border-before-width.conditionality="retain"
                            border-collapse="collapse"
                            table-layout="fixed"
                            width="100%">
                     <fo:table-column column-number="1" column-width="proportional-column-width(1)"/>
                     <fo:table-column column-number="2" column-width="proportional-column-width(1)"/>
                     <fo:table-header start-indent="0pt" end-indent="0pt">
                        <fo:table-row keep-together.within-column="always"
                                      keep-with-next.within-column="always"
                                      font-family="ProductusSemibold,ArialUnicodeMS">
                           <fo:table-cell padding-start="0pt"
                                          padding-end="4pt"
                                          padding-top="1pt"
                                          padding-bottom="1pt">
                              <fo:block>Name</fo:block>
                           </fo:table-cell>
                           <fo:table-cell padding-start="0pt"
                                          padding-end="4pt"
                                          padding-top="1pt"
                                          padding-bottom="1pt">
                              <fo:block>Description</fo:block>
                           </fo:table-cell>
                        </fo:table-row>
                     </fo:table-header>
                     <fo:table-body start-indent="0pt" end-indent="0pt">
                        <fo:table-row keep-together.within-column="always">
                           <fo:table-cell padding-start="0pt"
                                          padding-end="4pt"
                                          padding-top="1pt"
                                          padding-bottom="1pt">
                              <fo:block>
                                 <fo:inline font-family="ProductusOSGiBookc,ArialUnicodeMS"
                                            font-size="9pt"
                                            letter-spacing="0.08em">inverse</fo:inline>
                              </fo:block>
                           </fo:table-cell>
                           <fo:table-cell padding-start="0pt"
                                          padding-end="4pt"
                                          padding-top="1pt"
                                          padding-bottom="1pt">
                              <fo:block>Reverses the <fo:inline font-family="ProductusOSGiBookc,ArialUnicodeMS"
                                            font-size="9pt"
                                            letter-spacing="0.08em">BooleanControl</fo:inline> state. If the
              current state represents <fo:inline font-family="ProductusOSGiBookc,ArialUnicodeMS"
                                            font-size="9pt"
                                            letter-spacing="0.08em">true</fo:inline> value, it'll be
              changed to <fo:inline font-family="ProductusOSGiBookc,ArialUnicodeMS"
                                            font-size="9pt"
                                            letter-spacing="0.08em">false</fo:inline>. If the current state represents
              <fo:inline font-family="ProductusOSGiBookc,ArialUnicodeMS"
                                            font-size="9pt"
                                            letter-spacing="0.08em">false</fo:inline> value, it'll be changed to
              <fo:inline font-family="ProductusOSGiBookc,ArialUnicodeMS"
                                            font-size="9pt"
                                            letter-spacing="0.08em">true</fo:inline>.</fo:block>
                           </fo:table-cell>
                        </fo:table-row>
                        <fo:table-row keep-together.within-column="always">
                           <fo:table-cell padding-start="0pt"
                                          padding-end="4pt"
                                          padding-top="1pt"
                                          padding-bottom="1pt">
                              <fo:block>
                                 <fo:inline font-family="ProductusOSGiBookc,ArialUnicodeMS"
                                            font-size="9pt"
                                            letter-spacing="0.08em">setTrue</fo:inline>
                              </fo:block>
                           </fo:table-cell>
                           <fo:table-cell padding-start="0pt"
                                          padding-end="4pt"
                                          padding-top="1pt"
                                          padding-bottom="1pt">
                              <fo:block>Sets the <fo:inline font-family="ProductusOSGiBookc,ArialUnicodeMS"
                                            font-size="9pt"
                                            letter-spacing="0.08em">BooleanControl</fo:inline> state to
              <fo:inline font-family="ProductusOSGiBookc,ArialUnicodeMS"
                                            font-size="9pt"
                                            letter-spacing="0.08em">true</fo:inline> value.</fo:block>
                           </fo:table-cell>
                        </fo:table-row>
                        <fo:table-row keep-together.within-column="always">
                           <fo:table-cell padding-start="0pt"
                                          padding-end="4pt"
                                          padding-top="1pt"
                                          padding-bottom="1pt">
                              <fo:block>
                                 <fo:inline font-family="ProductusOSGiBookc,ArialUnicodeMS"
                                            font-size="9pt"
                                            letter-spacing="0.08em">setFalse</fo:inline>
                              </fo:block>
                           </fo:table-cell>
                           <fo:table-cell padding-start="0pt"
                                          padding-end="4pt"
                                          padding-top="1pt"
                                          padding-bottom="1pt">
                              <fo:block>Sets the <fo:inline font-family="ProductusOSGiBookc,ArialUnicodeMS"
                                            font-size="9pt"
                                            letter-spacing="0.08em">BooleanControl</fo:inline> state to
              <fo:inline font-family="ProductusOSGiBookc,ArialUnicodeMS"
                                            font-size="9pt"
                                            letter-spacing="0.08em">false</fo:inline> value.</fo:block>
                           </fo:table-cell>
                        </fo:table-row>
                     </fo:table-body>
                  </fo:table>
               </fo:block>
               <fo:block xmlns:rx="http://www.renderx.com/XSL/Extensions"
                         space-before.minimum="0.5em"
                         space-before.optimum="1em"
                         space-before.maximum="2em"
                         space-after.minimum="0.5em"
                         space-after.optimum="1em"
                         space-after.maximum="2em"
                         keep-together.within-column="auto"
                         id="d615e140">
                  <fo:block xmlns:d="http://docbook.org/ns/docbook"
                            xmlns:xlink="http://www.w3.org/1999/xlink"
                            space-before.optimum="5pt"
                            space-before.minimum="5pt"
                            space-before.maximum="5pt"
                            font-weight="normal"
                            font-size="9pt"
                            hyphenate="false"
                            space-after.minimum="0.4em"
                            space-after.optimum="0.6em"
                            space-after.maximum="0.8em"
                            start-indent="0pt"
                            font-family="Proforma-Book,ArialUnicodeMS"
                            font-style="italic"
                            keep-with-next.within-column="always">
                     <fo:list-block provisional-distance-between-starts="1in"
                                    provisional-label-separation="0.090in">
                        <fo:list-item>
                           <fo:list-item-label end-indent="label-end()" text-align="start">
                              <fo:block>Table 142.2</fo:block>
                           </fo:list-item-label>
                           <fo:list-item-body start-indent="body-start()">
                              <fo:block>BooleanControl Properties</fo:block>
                           </fo:list-item-body>
                        </fo:list-item>
                     </fo:list-block>
                  </fo:block>
                  <fo:table border-before-width.conditionality="retain"
                            border-collapse="collapse"
                            table-layout="fixed"
                            width="100%">
                     <fo:table-column column-number="1" column-width="proportional-column-width(1)"/>
                     <fo:table-column column-number="2" column-width="proportional-column-width(1)"/>
                     <fo:table-header start-indent="0pt" end-indent="0pt">
                        <fo:table-row keep-together.within-column="always"
                                      keep-with-next.within-column="always"
                                      font-family="ProductusSemibold,ArialUnicodeMS">
                           <fo:table-cell padding-start="0pt"
                                          padding-end="4pt"
                                          padding-top="1pt"
                                          padding-bottom="1pt">
                              <fo:block>Name</fo:block>
                           </fo:table-cell>
                           <fo:table-cell padding-start="0pt"
                                          padding-end="4pt"
                                          padding-top="1pt"
                                          padding-bottom="1pt">
                              <fo:block>Description</fo:block>
                           </fo:table-cell>
                        </fo:table-row>
                     </fo:table-header>
                     <fo:table-body start-indent="0pt" end-indent="0pt">
                        <fo:table-row keep-together.within-column="always">
                           <fo:table-cell padding-start="0pt"
                                          padding-end="4pt"
                                          padding-top="1pt"
                                          padding-bottom="1pt">
                              <fo:block>
                                 <fo:inline font-family="ProductusOSGiBookc,ArialUnicodeMS"
                                            font-size="9pt"
                                            letter-spacing="0.08em">data</fo:inline>
                              </fo:block>
                           </fo:table-cell>
                           <fo:table-cell padding-start="0pt"
                                          padding-end="4pt"
                                          padding-top="1pt"
                                          padding-bottom="1pt">
                              <fo:block>Contains the current state of
              <fo:inline font-family="ProductusOSGiBookc,ArialUnicodeMS"
                                            font-size="9pt"
                                            letter-spacing="0.08em">BooleanControl</fo:inline>. The property access is readable,
              writable and eventable.</fo:block>
                           </fo:table-cell>
                        </fo:table-row>
                     </fo:table-body>
                  </fo:table>
               </fo:block>
               <fo:block space-before.optimum="5pt"
                         space-before.minimum="5pt"
                         space-before.maximum="5pt">Different types can be used as a value of <fo:inline color="blue"
                             font-family="ProductusOSGiBookc,ArialUnicodeMS"
                             letter-spacing="0.08em"
                             hyphenate="false">???</fo:inline> service property. The next list contains some
      suitable to <fo:inline font-family="ProductusOSGiBookc,ArialUnicodeMS"
                             font-size="9pt"
                             letter-spacing="0.08em">BooleanControl</fo:inline>: <fo:list-block space-before.optimum="1em"
                                 space-before.minimum="0.8em"
                                 space-before.maximum="1.2em"
                                 space-after.optimum="1em"
                                 space-after.minimum="0.8em"
                                 space-after.maximum="1.2em"
                                 provisional-label-separation="0.2em"
                                 provisional-distance-between-starts="12pt"
                                 id="d615e161">
                     <fo:list-item space-before.optimum="2pt"
                                   space-before.minimum="2pt"
                                   space-before.maximum="2pt"
                                   id="d615e162">
                        <fo:list-item-label end-indent="label-end()">
                           <fo:block>•</fo:block>
                        </fo:list-item-label>
                        <fo:list-item-body start-indent="body-start()">
                           <fo:block>
                              <fo:block>
                                 <fo:basic-link xmlns:d="http://docbook.org/ns/docbook"
                                                xmlns:xlink="http://www.w3.org/1999/xlink"
                                                internal-destination="org.osgi.service.dal.functions.Types.LIGHT">
                                    <fo:inline color="blue"
                                               font-family="ProductusOSGiBookc,ArialUnicodeMS"
                                               letter-spacing="0.08em"
                                               hyphenate="false">LIGHT</fo:inline>
                                 </fo:basic-link> - indicates that there is a light device
            control. <fo:inline font-family="ProductusOSGiBookc,ArialUnicodeMS"
                                            font-size="9pt"
                                            letter-spacing="0.08em">true</fo:inline> state means that the light device will
            be turned on. <fo:inline font-family="ProductusOSGiBookc,ArialUnicodeMS"
                                            font-size="9pt"
                                            letter-spacing="0.08em">false</fo:inline> state means that the light device
            will be turned off.</fo:block>
                           </fo:block>
                        </fo:list-item-body>
                     </fo:list-item>
                     <fo:list-item space-before.optimum="2pt"
                                   space-before.minimum="2pt"
                                   space-before.maximum="2pt"
                                   id="d615e170">
                        <fo:list-item-label end-indent="label-end()">
                           <fo:block>•</fo:block>
                        </fo:list-item-label>
                        <fo:list-item-body start-indent="body-start()">
                           <fo:block>
                              <fo:block>
                                 <fo:basic-link xmlns:d="http://docbook.org/ns/docbook"
                                                xmlns:xlink="http://www.w3.org/1999/xlink"
                                                internal-destination="org.osgi.service.dal.functions.Types.DOOR">
                                    <fo:inline color="blue"
                                               font-family="ProductusOSGiBookc,ArialUnicodeMS"
                                               letter-spacing="0.08em"
                                               hyphenate="false">DOOR</fo:inline>
                                 </fo:basic-link> - indicates that there is a door position
            control. <fo:inline font-family="ProductusOSGiBookc,ArialUnicodeMS"
                                            font-size="9pt"
                                            letter-spacing="0.08em">true</fo:inline> state means that the door will be
            opened. <fo:inline font-family="ProductusOSGiBookc,ArialUnicodeMS"
                                            font-size="9pt"
                                            letter-spacing="0.08em">false</fo:inline> state means that the door will be
            closed.</fo:block>
                           </fo:block>
                        </fo:list-item-body>
                     </fo:list-item>
                     <fo:list-item space-before.optimum="2pt"
                                   space-before.minimum="2pt"
                                   space-before.maximum="2pt"
                                   id="d615e178">
                        <fo:list-item-label end-indent="label-end()">
                           <fo:block>•</fo:block>
                        </fo:list-item-label>
                        <fo:list-item-body start-indent="body-start()">
                           <fo:block>
                              <fo:block>
                                 <fo:basic-link xmlns:d="http://docbook.org/ns/docbook"
                                                xmlns:xlink="http://www.w3.org/1999/xlink"
                                                internal-destination="org.osgi.service.dal.functions.Types.WINDOW">
                                    <fo:inline color="blue"
                                               font-family="ProductusOSGiBookc,ArialUnicodeMS"
                                               letter-spacing="0.08em"
                                               hyphenate="false">WINDOW</fo:inline>
                                 </fo:basic-link> - indicates that there is a window
            position control. <fo:inline font-family="ProductusOSGiBookc,ArialUnicodeMS"
                                            font-size="9pt"
                                            letter-spacing="0.08em">true</fo:inline> state means that the window
            will be opened. <fo:inline font-family="ProductusOSGiBookc,ArialUnicodeMS"
                                            font-size="9pt"
                                            letter-spacing="0.08em">false</fo:inline> state means that the window
            will be closed.</fo:block>
                           </fo:block>
                        </fo:list-item-body>
                     </fo:list-item>
                     <fo:list-item space-before.optimum="2pt"
                                   space-before.minimum="2pt"
                                   space-before.maximum="2pt"
                                   id="d615e186">
                        <fo:list-item-label end-indent="label-end()">
                           <fo:block>•</fo:block>
                        </fo:list-item-label>
                        <fo:list-item-body start-indent="body-start()">
                           <fo:block>
                              <fo:block>
                                 <fo:basic-link xmlns:d="http://docbook.org/ns/docbook"
                                                xmlns:xlink="http://www.w3.org/1999/xlink"
                                                internal-destination="org.osgi.service.dal.functions.Types.POWER">
                                    <fo:inline color="blue"
                                               font-family="ProductusOSGiBookc,ArialUnicodeMS"
                                               letter-spacing="0.08em"
                                               hyphenate="false">POWER</fo:inline>
                                 </fo:basic-link> - indicates that there is electricity
            control. <fo:inline font-family="ProductusOSGiBookc,ArialUnicodeMS"
                                            font-size="9pt"
                                            letter-spacing="0.08em">true</fo:inline> state means that the power will be
            restored. <fo:inline font-family="ProductusOSGiBookc,ArialUnicodeMS"
                                            font-size="9pt"
                                            letter-spacing="0.08em">false</fo:inline> state means that the power will be
            cut.</fo:block>
                           </fo:block>
                        </fo:list-item-body>
                     </fo:list-item>
                     <fo:list-item space-before.optimum="2pt"
                                   space-before.minimum="2pt"
                                   space-before.maximum="2pt"
                                   id="d615e194">
                        <fo:list-item-label end-indent="label-end()">
                           <fo:block>•</fo:block>
                        </fo:list-item-label>
                        <fo:list-item-body start-indent="body-start()">
                           <fo:block>
                              <fo:block>other type defined in <fo:basic-link xmlns:d="http://docbook.org/ns/docbook"
                                                xmlns:xlink="http://www.w3.org/1999/xlink"
                                                internal-destination="org.osgi.service.dal.functions.Types">
                                    <fo:inline color="blue"
                                               font-family="ProductusOSGiBookc,ArialUnicodeMS"
                                               letter-spacing="0.08em"
                                               hyphenate="false">Types</fo:inline>
                                 </fo:basic-link>
                              </fo:block>
                           </fo:block>
                        </fo:list-item-body>
                     </fo:list-item>
                     <fo:list-item space-before.optimum="2pt"
                                   space-before.minimum="2pt"
                                   space-before.maximum="2pt"
                                   id="d615e198">
                        <fo:list-item-label end-indent="label-end()">
                           <fo:block>•</fo:block>
                        </fo:list-item-label>
                        <fo:list-item-body start-indent="body-start()">
                           <fo:block>
                              <fo:block>vendor specific</fo:block>
                           </fo:block>
                        </fo:list-item-body>
                     </fo:list-item>
                  </fo:list-block>
               </fo:block>
               <fo:block space-before.optimum="5pt"
                         space-before.minimum="5pt"
                         space-before.maximum="5pt">The function is using <fo:basic-link xmlns:d="http://docbook.org/ns/docbook"
                                 xmlns:xlink="http://www.w3.org/1999/xlink"
                                 internal-destination="service.dal.functions-data.boolean">
                     <fo:inline color="inherit"
                                font-family="inherit"
                                letter-spacing="inherit"
                                hyphenate="inherit">
                        <fo:inline font-style="italic">BooleanData</fo:inline> on page <fo:page-number-citation ref-id="service.dal.functions-data.boolean"/>
                     </fo:inline>
                  </fo:basic-link> data structure to provide
      the control state.</fo:block>
               <fo:block space-before.optimum="5pt"
                         space-before.minimum="5pt"
                         space-before.maximum="5pt">The next code snippet sets to <fo:inline font-family="ProductusOSGiBookc,ArialUnicodeMS"
                             font-size="9pt"
                             letter-spacing="0.08em">true</fo:inline> all
      <fo:inline font-family="ProductusOSGiBookc,ArialUnicodeMS"
                             font-size="9pt"
                             letter-spacing="0.08em">BooleanControl</fo:inline> functions, which control the light.
      <fo:block space-before.minimum="0.8em"
                            space-before.optimum="1em"
                            space-before.maximum="1.2em"
                            space-after.minimum="0.8em"
                            space-after.optimum="1em"
                            space-after.maximum="1.2em"
                            hyphenate="false"
                            wrap-option="no-wrap"
                            white-space-collapse="false"
                            white-space-treatment="preserve"
                            linefeed-treatment="preserve"
                            text-align="start"
                            font-family="ProductusOSGiMonoc,ArialUnicodeMS"
                            font-size="9pt"
                            letter-spacing="-.0em"
                            space-before="5pt"
                            space-after="3pt"
                            space-after.conditionality="retain"
                            start-indent="inherit"
                            line-height="11pt"
                            id="d615e210">ServiceReference[] booleanControlSRefs = context.getServiceReferences(
      BooleanControl.class.getName(),
      '(' + Function.SERVICE_TYPE + '=' + Types.LIGHT + ')');
if (booleanControlSRefs != null) {
  for (int i = 0; i &lt; booleanControlSRefs.length; i++) {
    BooleanControl booleanControl = (BooleanControl) context.getService(
        booleanControlSRefs[i]);
    if (booleanControl != null) {
      booleanControl.setTrue();
      context.ungetService(booleanControlSRefs[i]);
    }
  }
}</fo:block>
               </fo:block>
            </fo:block>
            <fo:block id="service.dal.functions-boolean.sensor">
               <fo:block>
                  <fo:block>
                     <fo:block keep-together.within-column="always"
                               margin-left="0pt"
                               font-family="ProductusSemibold,ArialUnicodeMS">
                        <fo:block keep-with-next.within-column="always">
                           <fo:block xmlns:d="http://docbook.org/ns/docbook"
                                     xmlns:xlink="http://www.w3.org/1999/xlink"
                                     font-family="ProductusSemibold,ArialUnicodeMS"
                                     font-weight="normal"
                                     keep-with-next.within-column="always"
                                     space-before.minimum="0.8em"
                                     space-before.optimum="1.0em"
                                     space-before.maximum="1.2em"
                                     text-align="start"
                                     start-indent="0pt"
                                     hyphenate="false">
                              <fo:block font-size="12pt"
                                        line-height="14pt"
                                        space-before="8pt"
                                        space-after="5pt">
                                 <fo:list-block provisional-distance-between-starts="1in"
                                                provisional-label-separation="0.090in">
                                    <fo:list-item>
                                       <fo:list-item-label end-indent="label-end()" text-align="start">
                                          <fo:block>142.2.2</fo:block>
                                       </fo:list-item-label>
                                       <fo:list-item-body start-indent="body-start()">
                                          <fo:block>BooleanSensor</fo:block>
                                       </fo:list-item-body>
                                    </fo:list-item>
                                 </fo:list-block>
                              </fo:block>
                           </fo:block>
                        </fo:block>
                     </fo:block>
                  </fo:block>
               </fo:block>
               <fo:block space-before.optimum="5pt"
                         space-before.minimum="5pt"
                         space-before.maximum="5pt">
                  <fo:basic-link xmlns:d="http://docbook.org/ns/docbook"
                                 xmlns:xlink="http://www.w3.org/1999/xlink"
                                 internal-destination="org.osgi.service.dal.functions.BooleanSensor">
                     <fo:inline color="blue"
                                font-family="ProductusOSGiBookc,ArialUnicodeMS"
                                letter-spacing="0.08em"
                                hyphenate="false">BooleanSensor</fo:inline>
                  </fo:basic-link> function provides binary sensor monitoring. It
      reports the state when an important event is available. There are no
      operations. The property eventing must follow the definition of Device
      Abstraction Layer, <fo:inline color="inherit"
                             font-family="inherit"
                             letter-spacing="inherit"
                             hyphenate="inherit">???</fo:inline>. The
      full function definition is available in the next table.</fo:block>
               <fo:block xmlns:rx="http://www.renderx.com/XSL/Extensions"
                         space-before.minimum="0.5em"
                         space-before.optimum="1em"
                         space-before.maximum="2em"
                         space-after.minimum="0.5em"
                         space-after.optimum="1em"
                         space-after.maximum="2em"
                         keep-together.within-column="auto"
                         id="d615e218">
                  <fo:block xmlns:d="http://docbook.org/ns/docbook"
                            xmlns:xlink="http://www.w3.org/1999/xlink"
                            space-before.optimum="5pt"
                            space-before.minimum="5pt"
                            space-before.maximum="5pt"
                            font-weight="normal"
                            font-size="9pt"
                            hyphenate="false"
                            space-after.minimum="0.4em"
                            space-after.optimum="0.6em"
                            space-after.maximum="0.8em"
                            start-indent="0pt"
                            font-family="Proforma-Book,ArialUnicodeMS"
                            font-style="italic"
                            keep-with-next.within-column="always">
                     <fo:list-block provisional-distance-between-starts="1in"
                                    provisional-label-separation="0.090in">
                        <fo:list-item>
                           <fo:list-item-label end-indent="label-end()" text-align="start">
                              <fo:block>Table 142.3</fo:block>
                           </fo:list-item-label>
                           <fo:list-item-body start-indent="body-start()">
                              <fo:block>BooleanSensor Properties</fo:block>
                           </fo:list-item-body>
                        </fo:list-item>
                     </fo:list-block>
                  </fo:block>
                  <fo:table border-before-width.conditionality="retain"
                            border-collapse="collapse"
                            table-layout="fixed"
                            width="100%">
                     <fo:table-column column-number="1" column-width="proportional-column-width(1)"/>
                     <fo:table-column column-number="2" column-width="proportional-column-width(1)"/>
                     <fo:table-header start-indent="0pt" end-indent="0pt">
                        <fo:table-row keep-together.within-column="always"
                                      keep-with-next.within-column="always"
                                      font-family="ProductusSemibold,ArialUnicodeMS">
                           <fo:table-cell padding-start="0pt"
                                          padding-end="4pt"
                                          padding-top="1pt"
                                          padding-bottom="1pt">
                              <fo:block>Name</fo:block>
                           </fo:table-cell>
                           <fo:table-cell padding-start="0pt"
                                          padding-end="4pt"
                                          padding-top="1pt"
                                          padding-bottom="1pt">
                              <fo:block>Description</fo:block>
                           </fo:table-cell>
                        </fo:table-row>
                     </fo:table-header>
                     <fo:table-body start-indent="0pt" end-indent="0pt">
                        <fo:table-row keep-together.within-column="always">
                           <fo:table-cell padding-start="0pt"
                                          padding-end="4pt"
                                          padding-top="1pt"
                                          padding-bottom="1pt">
                              <fo:block>
                                 <fo:inline font-family="ProductusOSGiBookc,ArialUnicodeMS"
                                            font-size="9pt"
                                            letter-spacing="0.08em">data</fo:inline>
                              </fo:block>
                           </fo:table-cell>
                           <fo:table-cell padding-start="0pt"
                                          padding-end="4pt"
                                          padding-top="1pt"
                                          padding-bottom="1pt">
                              <fo:block>Contains the current state of <fo:inline font-family="ProductusOSGiBookc,ArialUnicodeMS"
                                            font-size="9pt"
                                            letter-spacing="0.08em">BooleanSensor</fo:inline>.
              The property access is readable and eventable.</fo:block>
                           </fo:table-cell>
                        </fo:table-row>
                     </fo:table-body>
                  </fo:table>
               </fo:block>
               <fo:block space-before.optimum="5pt"
                         space-before.minimum="5pt"
                         space-before.maximum="5pt">Different types can be used as a value of <fo:inline color="blue"
                             font-family="ProductusOSGiBookc,ArialUnicodeMS"
                             letter-spacing="0.08em"
                             hyphenate="false">???</fo:inline> service property. The next list contains some
      suitable to <fo:inline font-family="ProductusOSGiBookc,ArialUnicodeMS"
                             font-size="9pt"
                             letter-spacing="0.08em">BooleanSensor</fo:inline>: <fo:list-block space-before.optimum="1em"
                                 space-before.minimum="0.8em"
                                 space-before.maximum="1.2em"
                                 space-after.optimum="1em"
                                 space-after.minimum="0.8em"
                                 space-after.maximum="1.2em"
                                 provisional-label-separation="0.2em"
                                 provisional-distance-between-starts="12pt"
                                 id="d615e239">
                     <fo:list-item space-before.optimum="2pt"
                                   space-before.minimum="2pt"
                                   space-before.maximum="2pt"
                                   id="d615e240">
                        <fo:list-item-label end-indent="label-end()">
                           <fo:block>•</fo:block>
                        </fo:list-item-label>
                        <fo:list-item-body start-indent="body-start()">
                           <fo:block>
                              <fo:block>
                                 <fo:basic-link xmlns:d="http://docbook.org/ns/docbook"
                                                xmlns:xlink="http://www.w3.org/1999/xlink"
                                                internal-destination="org.osgi.service.dal.functions.Types.LIGHT">
                                    <fo:inline color="blue"
                                               font-family="ProductusOSGiBookc,ArialUnicodeMS"
                                               letter-spacing="0.08em"
                                               hyphenate="false">LIGHT</fo:inline>
                                 </fo:basic-link> - indicates that the
            <fo:inline font-family="ProductusOSGiBookc,ArialUnicodeMS"
                                            font-size="9pt"
                                            letter-spacing="0.08em">BooleanSensor</fo:inline> can detected light. <fo:inline font-family="ProductusOSGiBookc,ArialUnicodeMS"
                                            font-size="9pt"
                                            letter-spacing="0.08em">true</fo:inline>
            state means that there is light. <fo:inline font-family="ProductusOSGiBookc,ArialUnicodeMS"
                                            font-size="9pt"
                                            letter-spacing="0.08em">false</fo:inline> state means
            that there is no light.</fo:block>
                           </fo:block>
                        </fo:list-item-body>
                     </fo:list-item>
                     <fo:list-item space-before.optimum="2pt"
                                   space-before.minimum="2pt"
                                   space-before.maximum="2pt"
                                   id="d615e250">
                        <fo:list-item-label end-indent="label-end()">
                           <fo:block>•</fo:block>
                        </fo:list-item-label>
                        <fo:list-item-body start-indent="body-start()">
                           <fo:block>
                              <fo:block>
                                 <fo:basic-link xmlns:d="http://docbook.org/ns/docbook"
                                                xmlns:xlink="http://www.w3.org/1999/xlink"
                                                internal-destination="org.osgi.service.dal.functions.Types.GAS">
                                    <fo:inline color="blue"
                                               font-family="ProductusOSGiBookc,ArialUnicodeMS"
                                               letter-spacing="0.08em"
                                               hyphenate="false">GAS</fo:inline>
                                 </fo:basic-link> - indicates that the
            <fo:inline font-family="ProductusOSGiBookc,ArialUnicodeMS"
                                            font-size="9pt"
                                            letter-spacing="0.08em">BooleanSensor</fo:inline> supports gas detection.
            <fo:inline font-family="ProductusOSGiBookc,ArialUnicodeMS"
                                            font-size="9pt"
                                            letter-spacing="0.08em">true</fo:inline> state means there is gas. <fo:inline font-family="ProductusOSGiBookc,ArialUnicodeMS"
                                            font-size="9pt"
                                            letter-spacing="0.08em">false</fo:inline>
            state means that there is no gas.</fo:block>
                           </fo:block>
                        </fo:list-item-body>
                     </fo:list-item>
                     <fo:list-item space-before.optimum="2pt"
                                   space-before.minimum="2pt"
                                   space-before.maximum="2pt"
                                   id="d615e260">
                        <fo:list-item-label end-indent="label-end()">
                           <fo:block>•</fo:block>
                        </fo:list-item-label>
                        <fo:list-item-body start-indent="body-start()">
                           <fo:block>
                              <fo:block>
                                 <fo:basic-link xmlns:d="http://docbook.org/ns/docbook"
                                                xmlns:xlink="http://www.w3.org/1999/xlink"
                                                internal-destination="org.osgi.service.dal.functions.Types.SMOKE">
                                    <fo:inline color="blue"
                                               font-family="ProductusOSGiBookc,ArialUnicodeMS"
                                               letter-spacing="0.08em"
                                               hyphenate="false">SMOKE</fo:inline>
                                 </fo:basic-link> - indicates that the
            <fo:inline font-family="ProductusOSGiBookc,ArialUnicodeMS"
                                            font-size="9pt"
                                            letter-spacing="0.08em">BooleanSensor</fo:inline> can detect smoke. <fo:inline font-family="ProductusOSGiBookc,ArialUnicodeMS"
                                            font-size="9pt"
                                            letter-spacing="0.08em">true</fo:inline>
            state means that there is smoke. <fo:inline font-family="ProductusOSGiBookc,ArialUnicodeMS"
                                            font-size="9pt"
                                            letter-spacing="0.08em">false</fo:inline> state means
            that there is no smoke.</fo:block>
                           </fo:block>
                        </fo:list-item-body>
                     </fo:list-item>
                     <fo:list-item space-before.optimum="2pt"
                                   space-before.minimum="2pt"
                                   space-before.maximum="2pt"
                                   id="d615e270">
                        <fo:list-item-label end-indent="label-end()">
                           <fo:block>•</fo:block>
                        </fo:list-item-label>
                        <fo:list-item-body start-indent="body-start()">
                           <fo:block>
                              <fo:block>
                                 <fo:basic-link xmlns:d="http://docbook.org/ns/docbook"
                                                xmlns:xlink="http://www.w3.org/1999/xlink"
                                                internal-destination="org.osgi.service.dal.functions.Types.DOOR">
                                    <fo:inline color="blue"
                                               font-family="ProductusOSGiBookc,ArialUnicodeMS"
                                               letter-spacing="0.08em"
                                               hyphenate="false">DOOR</fo:inline>
                                 </fo:basic-link> - indicates that the
            <fo:inline font-family="ProductusOSGiBookc,ArialUnicodeMS"
                                            font-size="9pt"
                                            letter-spacing="0.08em">BooleanSensor</fo:inline> can detect the door state.
            <fo:inline font-family="ProductusOSGiBookc,ArialUnicodeMS"
                                            font-size="9pt"
                                            letter-spacing="0.08em">true</fo:inline> state means that the door is opened.
            <fo:inline font-family="ProductusOSGiBookc,ArialUnicodeMS"
                                            font-size="9pt"
                                            letter-spacing="0.08em">false</fo:inline> state means that the door is closed.</fo:block>
                           </fo:block>
                        </fo:list-item-body>
                     </fo:list-item>
                     <fo:list-item space-before.optimum="2pt"
                                   space-before.minimum="2pt"
                                   space-before.maximum="2pt"
                                   id="d615e280">
                        <fo:list-item-label end-indent="label-end()">
                           <fo:block>•</fo:block>
                        </fo:list-item-label>
                        <fo:list-item-body start-indent="body-start()">
                           <fo:block>
                              <fo:block>
                                 <fo:basic-link xmlns:d="http://docbook.org/ns/docbook"
                                                xmlns:xlink="http://www.w3.org/1999/xlink"
                                                internal-destination="org.osgi.service.dal.functions.Types.WINDOW">
                                    <fo:inline color="blue"
                                               font-family="ProductusOSGiBookc,ArialUnicodeMS"
                                               letter-spacing="0.08em"
                                               hyphenate="false">WINDOW</fo:inline>
                                 </fo:basic-link> - indicates that the
            <fo:inline font-family="ProductusOSGiBookc,ArialUnicodeMS"
                                            font-size="9pt"
                                            letter-spacing="0.08em">BooleanSensor</fo:inline> can window state. <fo:inline font-family="ProductusOSGiBookc,ArialUnicodeMS"
                                            font-size="9pt"
                                            letter-spacing="0.08em">true</fo:inline>
            state means that the window is opened. <fo:inline font-family="ProductusOSGiBookc,ArialUnicodeMS"
                                            font-size="9pt"
                                            letter-spacing="0.08em">false</fo:inline> state
            means that the window is closed.</fo:block>
                           </fo:block>
                        </fo:list-item-body>
                     </fo:list-item>
                     <fo:list-item space-before.optimum="2pt"
                                   space-before.minimum="2pt"
                                   space-before.maximum="2pt"
                                   id="d615e290">
                        <fo:list-item-label end-indent="label-end()">
                           <fo:block>•</fo:block>
                        </fo:list-item-label>
                        <fo:list-item-body start-indent="body-start()">
                           <fo:block>
                              <fo:block>
                                 <fo:basic-link xmlns:d="http://docbook.org/ns/docbook"
                                                xmlns:xlink="http://www.w3.org/1999/xlink"
                                                internal-destination="org.osgi.service.dal.functions.Types.POWER">
                                    <fo:inline color="blue"
                                               font-family="ProductusOSGiBookc,ArialUnicodeMS"
                                               letter-spacing="0.08em"
                                               hyphenate="false">POWER</fo:inline>
                                 </fo:basic-link> - indicates that the
            <fo:inline font-family="ProductusOSGiBookc,ArialUnicodeMS"
                                            font-size="9pt"
                                            letter-spacing="0.08em">BooleanSensor</fo:inline> can detect power/no power.
            <fo:inline font-family="ProductusOSGiBookc,ArialUnicodeMS"
                                            font-size="9pt"
                                            letter-spacing="0.08em">true</fo:inline> state means that there is power.
            <fo:inline font-family="ProductusOSGiBookc,ArialUnicodeMS"
                                            font-size="9pt"
                                            letter-spacing="0.08em">false</fo:inline> state means that there is no power.</fo:block>
                           </fo:block>
                        </fo:list-item-body>
                     </fo:list-item>
                     <fo:list-item space-before.optimum="2pt"
                                   space-before.minimum="2pt"
                                   space-before.maximum="2pt"
                                   id="d615e300">
                        <fo:list-item-label end-indent="label-end()">
                           <fo:block>•</fo:block>
                        </fo:list-item-label>
                        <fo:list-item-body start-indent="body-start()">
                           <fo:block>
                              <fo:block>
                                 <fo:basic-link xmlns:d="http://docbook.org/ns/docbook"
                                                xmlns:xlink="http://www.w3.org/1999/xlink"
                                                internal-destination="org.osgi.service.dal.functions.Types.RAIN">
                                    <fo:inline color="blue"
                                               font-family="ProductusOSGiBookc,ArialUnicodeMS"
                                               letter-spacing="0.08em"
                                               hyphenate="false">RAIN</fo:inline>
                                 </fo:basic-link> - indicates that the
            <fo:inline font-family="ProductusOSGiBookc,ArialUnicodeMS"
                                            font-size="9pt"
                                            letter-spacing="0.08em">BooleanSensor</fo:inline> can detect rain. <fo:inline font-family="ProductusOSGiBookc,ArialUnicodeMS"
                                            font-size="9pt"
                                            letter-spacing="0.08em">true</fo:inline>
            state means that there is rain. <fo:inline font-family="ProductusOSGiBookc,ArialUnicodeMS"
                                            font-size="9pt"
                                            letter-spacing="0.08em">false</fo:inline> state means
            that there is no rain.</fo:block>
                           </fo:block>
                        </fo:list-item-body>
                     </fo:list-item>
                     <fo:list-item space-before.optimum="2pt"
                                   space-before.minimum="2pt"
                                   space-before.maximum="2pt"
                                   id="d615e310">
                        <fo:list-item-label end-indent="label-end()">
                           <fo:block>•</fo:block>
                        </fo:list-item-label>
                        <fo:list-item-body start-indent="body-start()">
                           <fo:block>
                              <fo:block>
                                 <fo:basic-link xmlns:d="http://docbook.org/ns/docbook"
                                                xmlns:xlink="http://www.w3.org/1999/xlink"
                                                internal-destination="org.osgi.service.dal.functions.Types.CONTACT">
                                    <fo:inline color="blue"
                                               font-family="ProductusOSGiBookc,ArialUnicodeMS"
                                               letter-spacing="0.08em"
                                               hyphenate="false">CONTACT</fo:inline>
                                 </fo:basic-link> - indicates that the
            <fo:inline font-family="ProductusOSGiBookc,ArialUnicodeMS"
                                            font-size="9pt"
                                            letter-spacing="0.08em">BooleanSensor</fo:inline> can detect contact. <fo:inline font-family="ProductusOSGiBookc,ArialUnicodeMS"
                                            font-size="9pt"
                                            letter-spacing="0.08em">true</fo:inline>
            state means that there is contact. <fo:inline font-family="ProductusOSGiBookc,ArialUnicodeMS"
                                            font-size="9pt"
                                            letter-spacing="0.08em">false</fo:inline> state means
            that there is no contact.</fo:block>
                           </fo:block>
                        </fo:list-item-body>
                     </fo:list-item>
                     <fo:list-item space-before.optimum="2pt"
                                   space-before.minimum="2pt"
                                   space-before.maximum="2pt"
                                   id="d615e320">
                        <fo:list-item-label end-indent="label-end()">
                           <fo:block>•</fo:block>
                        </fo:list-item-label>
                        <fo:list-item-body start-indent="body-start()">
                           <fo:block>
                              <fo:block>
                                 <fo:basic-link xmlns:d="http://docbook.org/ns/docbook"
                                                xmlns:xlink="http://www.w3.org/1999/xlink"
                                                internal-destination="org.osgi.service.dal.functions.Types.FIRE">
                                    <fo:inline color="blue"
                                               font-family="ProductusOSGiBookc,ArialUnicodeMS"
                                               letter-spacing="0.08em"
                                               hyphenate="false">FIRE</fo:inline>
                                 </fo:basic-link> - indicates that the
            <fo:inline font-family="ProductusOSGiBookc,ArialUnicodeMS"
                                            font-size="9pt"
                                            letter-spacing="0.08em">BooleanSensor</fo:inline> can detect fire. <fo:inline font-family="ProductusOSGiBookc,ArialUnicodeMS"
                                            font-size="9pt"
                                            letter-spacing="0.08em">true</fo:inline>
            state means that there is fire. <fo:inline font-family="ProductusOSGiBookc,ArialUnicodeMS"
                                            font-size="9pt"
                                            letter-spacing="0.08em">false</fo:inline> state means
            that there is no fire.</fo:block>
                           </fo:block>
                        </fo:list-item-body>
                     </fo:list-item>
                     <fo:list-item space-before.optimum="2pt"
                                   space-before.minimum="2pt"
                                   space-before.maximum="2pt"
                                   id="d615e330">
                        <fo:list-item-label end-indent="label-end()">
                           <fo:block>•</fo:block>
                        </fo:list-item-label>
                        <fo:list-item-body start-indent="body-start()">
                           <fo:block>
                              <fo:block>
                                 <fo:basic-link xmlns:d="http://docbook.org/ns/docbook"
                                                xmlns:xlink="http://www.w3.org/1999/xlink"
                                                internal-destination="org.osgi.service.dal.functions.Types.OCCUPANCY">
                                    <fo:inline color="blue"
                                               font-family="ProductusOSGiBookc,ArialUnicodeMS"
                                               letter-spacing="0.08em"
                                               hyphenate="false">OCCUPANCY</fo:inline>
                                 </fo:basic-link> - indicates that the
            <fo:inline font-family="ProductusOSGiBookc,ArialUnicodeMS"
                                            font-size="9pt"
                                            letter-spacing="0.08em">BooleanSensor</fo:inline> can detect presence. <fo:inline font-family="ProductusOSGiBookc,ArialUnicodeMS"
                                            font-size="9pt"
                                            letter-spacing="0.08em">true</fo:inline>
            state means that someone is detected. <fo:inline font-family="ProductusOSGiBookc,ArialUnicodeMS"
                                            font-size="9pt"
                                            letter-spacing="0.08em">false</fo:inline> state
            means that nobody is detected.</fo:block>
                           </fo:block>
                        </fo:list-item-body>
                     </fo:list-item>
                     <fo:list-item space-before.optimum="2pt"
                                   space-before.minimum="2pt"
                                   space-before.maximum="2pt"
                                   id="d615e340">
                        <fo:list-item-label end-indent="label-end()">
                           <fo:block>•</fo:block>
                        </fo:list-item-label>
                        <fo:list-item-body start-indent="body-start()">
                           <fo:block>
                              <fo:block>
                                 <fo:basic-link xmlns:d="http://docbook.org/ns/docbook"
                                                xmlns:xlink="http://www.w3.org/1999/xlink"
                                                internal-destination="org.osgi.service.dal.functions.Types.WATER">
                                    <fo:inline color="blue"
                                               font-family="ProductusOSGiBookc,ArialUnicodeMS"
                                               letter-spacing="0.08em"
                                               hyphenate="false">WATER</fo:inline>
                                 </fo:basic-link> - indicates that the
            <fo:inline font-family="ProductusOSGiBookc,ArialUnicodeMS"
                                            font-size="9pt"
                                            letter-spacing="0.08em">BooleanSensor</fo:inline> can detect water leak.
            <fo:inline font-family="ProductusOSGiBookc,ArialUnicodeMS"
                                            font-size="9pt"
                                            letter-spacing="0.08em">true</fo:inline> state means that there is water leak.
            <fo:inline font-family="ProductusOSGiBookc,ArialUnicodeMS"
                                            font-size="9pt"
                                            letter-spacing="0.08em">false</fo:inline> state means that there is no water leak.</fo:block>
                           </fo:block>
                        </fo:list-item-body>
                     </fo:list-item>
                     <fo:list-item space-before.optimum="2pt"
                                   space-before.minimum="2pt"
                                   space-before.maximum="2pt"
