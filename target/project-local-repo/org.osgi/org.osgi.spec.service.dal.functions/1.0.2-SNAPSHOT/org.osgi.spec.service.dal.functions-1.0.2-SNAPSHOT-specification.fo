            <fo:inline font-family="ProductusOSGiBookc,ArialUnicodeMS"
                                            font-size="9pt"
                                            letter-spacing="0.08em">MultiLevelSensor</fo:inline> can monitor the rain rate.</fo:block>
                           </fo:block>
                        </fo:list-item-body>
